{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "lift-nutrientes.vercel.app"
        }
      ],
      "destination": "https://supgo.co/:path*",
      "permanent": true
    }
  ],
  "functions": {
    "api/producto.js": {
      "includeFiles": "producto/index.html"
    },
    "api/coleccion.js": {
      "includeFiles": "{categorias,laboratorios}/plantilla.html"
    },
    "api/pagina.js": {
      "includeFiles": "{home,categorias,laboratorios,ofertas,guias,politica-de-devoluciones,tratamiento-de-datos}/*.html"
    }
  },
  "routes": [
    {
      "src": "^/merchant-feed\\.xml$",
      "dest": "/api/merchant-feed"
    },
    {
      "src": "^/sitemap\\.xml$",
      "dest": "/api/sitemap?tipo=index"
    },
    {
      "src": "^/sitemap-(productos|categorias|laboratorios|paginas|guias)\\.xml$",
      "dest": "/api/sitemap?tipo=$1"
    },
    {
      "src": "^/sitemaps/(productos|categorias|laboratorios|paginas|guias)\\.xml$",
      "dest": "/api/sitemap?tipo=$1"
    },
    {
      "src": "^/home/?$",
      "dest": "/api/pagina?ruta=home"
    },
    {
      "src": "^/categorias/?$",
      "dest": "/api/pagina?ruta=categorias"
    },
    {
      "src": "^/laboratorios/?$",
      "dest": "/api/pagina?ruta=laboratorios"
    },
    {
      "src": "^/ofertas/?$",
      "dest": "/api/pagina?ruta=ofertas"
    },
    {
      "src": "^/guias/?$",
      "dest": "/api/pagina?ruta=guias"
    },
    {
      "src": "^/politica-de-devoluciones/?$",
      "dest": "/api/pagina?ruta=politica-de-devoluciones"
    },
    {
      "src": "^/tratamiento-de-datos/?$",
      "dest": "/api/pagina?ruta=tratamiento-de-datos"
    },
    {
      "src": "^/guias/([a-z0-9-]+)\\.html$",
      "dest": "/api/pagina?ruta=guias/$1"
    },
    {
      "src": "^/s/([A-Za-z0-9_-]{12})/?$",
      "dest": "/s/index.html"
    },
    {
      "src": "^/producto/([a-z0-9-]+)/?$",
      "dest": "/api/producto?slug=$1"
    },
    {
      "src": "^/categorias/([a-z0-9-]+)/?$",
      "dest": "/api/coleccion?tipo=categoria&slug=$1"
    },
    {
      "src": "^/laboratorios/([a-z0-9-]+)/?$",
      "dest": "/api/coleccion?tipo=laboratorio&slug=$1"
    },
    {
      "handle": "filesystem"
    }
  ]
}
