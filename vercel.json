{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "lift-nutrientes.vercel.app"
        }
      ],
      "destination": "https://supgo.co/:path*",
      "permanent": true
    }
  ],
  "functions": {
    "api/producto.js": {
      "includeFiles": "{producto/index.html,scripts/fichas_heredadas.json}"
    },
    "api/coleccion.js": {
      "includeFiles": "{categorias/plantilla.html,laboratorios/plantilla.html,guias/guias.json}"
    },
    "api/pagina.js": {
      "includeFiles": "{home,categorias,laboratorios,ofertas,guias,politica-de-devoluciones,tratamiento-de-datos}/*.html"
    }
  },
  "routes": [
    {
      "src": "^/img/(web/[A-Za-z0-9_-]+\\.(?:jpg|png|webp|gif|avif|svg))$",
      "dest": "https://vdxkknftyssjyfbdieqa.supabase.co/storage/v1/object/public/lift-productos/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable",
        "CDN-Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "^/catalogo\\.pdf$",
      "dest": "https://vdxkknftyssjyfbdieqa.supabase.co/storage/v1/object/public/supgo-catalogo-publico/supgo-catalogo.pdf",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate",
        "CDN-Cache-Control": "public, max-age=60",
        "Content-Disposition": "inline"
      }
    },
    {
      "src": "^/catalogo-entrenador\\.pdf$",
      "dest": "https://vdxkknftyssjyfbdieqa.supabase.co/storage/v1/object/public/supgo-catalogo-publico/supgo-catalogo-entrenador.pdf",
      "headers": {
        "Cache-Control": "public, max-age=0, must-revalidate",
        "CDN-Cache-Control": "public, max-age=60",
        "Content-Disposition": "inline"
      }
    },
    {
      "src": "^/merchant-feed\\.xml$",
      "dest": "/api/merchant-feed"
    },
    {
      "src": "^/sitemap\\.xml$",
      "dest": "/api/sitemap?tipo=index"
    },
    {
      "src": "^/sitemap-(productos|categorias|laboratorios|paginas|guias)\\.xml$",
      "dest": "/api/sitemap?tipo=$1"
    },
    {
      "src": "^/sitemaps/(productos|categorias|laboratorios|paginas|guias)\\.xml$",
      "dest": "/api/sitemap?tipo=$1"
    },
    {
      "src": "^/$",
      "dest": "/api/pagina?ruta=home"
    },
    {
      "src": "^/home/?$",
      "dest": "/api/pagina?ruta=home&desde=home"
    },
    {
      "src": "^/productos/?$",
      "status": 301,
      "headers": {
        "Location": "/categorias/"
      }
    },
    {
      "src": "^/productos/([A-Za-z0-9._-]+?)(?:\\.html)?/?$",
      "dest": "/api/producto?legado=$1"
    },
    {
      "src": "^/categorias/?$",
      "dest": "/api/pagina?ruta=categorias"
    },
    {
      "src": "^/laboratorios/?$",
      "dest": "/api/pagina?ruta=laboratorios"
    },
    {
      "src": "^/ofertas/?$",
      "dest": "/api/pagina?ruta=ofertas"
    },
    {
      "src": "^/guias/?$",
      "dest": "/api/pagina?ruta=guias"
    },
    {
      "src": "^/politica-de-devoluciones/?$",
      "dest": "/api/pagina?ruta=politica-de-devoluciones"
    },
    {
      "src": "^/tratamiento-de-datos/?$",
      "dest": "/api/pagina?ruta=tratamiento-de-datos"
    },
    {
      "src": "^/guias/([a-z0-9-]+)\\.html$",
      "dest": "/api/pagina?ruta=guias/$1"
    },
    {
      "src": "^/s/([A-Za-z0-9_-]{12})/?$",
      "dest": "/s/index.html"
    },
    {
      "src": "^/producto/mind-f-cker-30-serv-tangarine/?$",
      "status": 301,
      "headers": {
        "Location": "/producto/creapure-300-gramos-100-servicios/"
      }
    },
    {
      "src": "^/producto/([a-z0-9-]+)/?$",
      "dest": "/api/producto?slug=$1"
    },
    {
      "src": "^/categorias/([a-z0-9-]+)/?$",
      "dest": "/api/coleccion?tipo=categoria&slug=$1"
    },
    {
      "src": "^/laboratorios/([a-z0-9-]+)/?$",
      "dest": "/api/coleccion?tipo=laboratorio&slug=$1"
    },
    {
      "handle": "filesystem"
    }
  ]
}
